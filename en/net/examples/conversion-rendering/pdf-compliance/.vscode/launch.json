{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run example (evaluation)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/bin/Debug/net8.0/Example.dll",
      "cwd": "${workspaceFolder}",
      "args": [
        "--mode",
        "evaluation"
      ],
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
