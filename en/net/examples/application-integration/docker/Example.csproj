<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12.0</LangVersion>
    <RollForward>Major</RollForward>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestoreLockedMode>false</RestoreLockedMode>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>Example</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <PackageReference Include="Aspose.Slides.NET6.CrossPlatform" Version="[26.10.0]" />

    <None Remove="Fixtures/**/*;Fonts/**/*;example-manifest.json" />
    <Content Remove="Fixtures/**/*;Fonts/**/*;example-manifest.json" />
    <Content Include="Fixtures/**/*;Fonts/**/*;example-manifest.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
